[Unit]
Description=GlobalCareer AI Engine — Autonomous Job Scout
After=network.target

[Service]
Type=simple
User=upc
WorkingDirectory=/home/upc/pradeep-workspace/.claude/worktrees/globalcareer-fix/GlobalCareer-AI-Engine
Environment=PATH=/home/upc/pradeep-workspace/.claude/worktrees/globalcareer-fix/GlobalCareer-AI-Engine/venv/bin
ExecStart=/home/upc/pradeep-workspace/.claude/worktrees/globalcareer-fix/GlobalCareer-AI-Engine/venv/bin/python3 main.py --schedule
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=globalcareer

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target